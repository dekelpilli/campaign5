{:storage    {:backend :file}
 :server     {:port 5555}
 :history    :always
 :tools      [{:type  :jar
               :id    :souls
               :label "Souls"
               :jar   {:path       "target/campaign5.jar"
                       :entrypoint campaign5.souls/-soul-generator}}
              {:type  :jar
               :id    :reliquaries
               :label "Reliquaries"
               :jar   {:path       "target/campaign5.jar"
                       :entrypoint campaign5.reliquaries/-reliquary-generator}}
              {:type  :data
               :id    :rings
               :label "Rings"
               :data  {:source "data-plugins/rings.edn"}}
              {:type      :data
               :id        :tarot-loot
               :label     "Draw tarot cards"
               :generator {:hidden? true
                           :history :never}
               :data      {:inline {:view-model {:loot/title    "Tarot cards"
                                                 :loot/sections [{:section/items [{:item/body "Draw 1 tarot card"}]}]}}}}
              {:type      :jar
               :id        :tarot
               :label     "Tarot cards"
               :generator {:history :button}
               :jar       {:path       "target/campaign5.jar"
                           :entrypoint campaign5.tarot/-tarot-generator}}
              {:type  :jar
               :id    :tattoos
               :label "Tattoos"
               :jar   {:path       "target/campaign5.jar"
                       ;TODO replace with actual tattoo generation once implemented
                       :entrypoint campaign5.shrines/-shrine-generator}}
              {:type      :jar
               :id        :vestiges
               :label     "Vestiges"
               :generator {:history :button}
               :jar       {:path       "target/campaign5.jar"
                           :entrypoint campaign5.vestiges/-vestige-generator}}
              {:type  :data
               :id    :missions
               :label "Missions"
               :data  {:source "data-plugins/missions.edn"}}
              {:type  :jar
               :id    :shrines
               :label "Shrines"
               :jar   {:path       "target/campaign5.jar"
                       :entrypoint campaign5.shrines/-shrine-generator}}
              {:type    :jar
               :id      :soul-procs
               :label   "Soul Procs"
               :section "Utilities"
               :jar     {:path       "target/campaign5.jar"
                         :entrypoint campaign5.soul-procs/-soul-proc-generator}}
              {:type    :builtin
               :id      :social
               :label   "Group Social"
               :section "Utilities"}]
 :reporting  #include "reporting.edn"
 :loot-table [{:id     :rings
               :ranges [[1 18] [100 100]]}
              {:id     :souls
               :ranges [[19 36] [100 100]]}
              {:id     :tarot
               :ranges [[37 54] [100 100]]}
              {:id     :tattoos
               :ranges [[55 72] [100 100]]}
              {:id     :vestiges
               :ranges [[73 90] [100 100]]}
              {:id     :missions
               :ranges [[91 99]]}]}
