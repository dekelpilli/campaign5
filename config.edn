{:storage    {:backend :file} ;TODO consider mysql?
 :server     {:port 5555}
 :plugins    [{:type       :jar
               :id         :souls
               :jar        "target/campaign5.jar"
               :entrypoint campaign5.souls/-soul-generator}
              {:type       :jar
               :id         :reliquaries
               :jar        "target/campaign5.jar"
               :entrypoint campaign5.reliquaries/-reliquary-generator}
              {:type   :data
               :id     :rings
               :source "data-plugins/rings.edn"}
              {:type    :data
               :id      :tarot
               :hidden? true
               :inline  {:label    "Tarot cards"
                         :items    [{:instruction "Draw 3 tarot cards"}]
                         :title    "Tarot cards"
                         :sections [{:each :items
                                     :item {:body "{{ instruction }}"}}]}}
              {:type       :jar
               :id         :trinkets
               :jar        "target/campaign5.jar"
               :entrypoint campaign5.trinkets/-trinket-generator}
              {:type   :data
               :id     :minor-shrines
               :source "data-plugins/minor-shrines.edn"}
              {:type       :jar
               :id         :mythic-shrines
               :jar        "target/campaign5.jar"
               :entrypoint campaign5.mythic-shrines/-mythic-shrine-generator}]
 :reporting  #include "reporting.edn"
 ;TODO consider adding missions/omens as a low-weight loot result (gives mission + reroll), or some other special result at 96+/100
 ;  missions could be a good way to grant perk points?
 :loot-table [{:id :rings}
              {:id :souls}
              {:id :tarot}
              #_{:id :tattoos}
              {:id :trinkets}]}
