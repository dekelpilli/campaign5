{:era    [{:template "While all contained souls are from different eras, +1 rank to the passive mod of the last soul in this reliquary"}
          {:state    {:absorption 1}
           :template "+{{ absorption }} {{ x|random:damage-types }} absorption for each unique soul era in this reliquary"}
          {:state    {:asi 1}
           :template "+{{ asi }} Charisma while at least one contained soul is from the unborn era"}
          {:state    {:asi 1}
           :template "+{{ asi }} Dexterity while at least one contained soul is from the modern era"}
          {:state    {:asi 1}
           :template "+{{ asi }} Intelligence while at least one contained soul is from the olden era"}
          {:state    {:asi 1}
           :template "+{{ asi }} Strength while at least one contained soul is from the ancient era"}
          {:state    {:asi 1}
           :template "+{{ asi }} Wisdom while at least one contained soul is from the prehistoric era"}
          {:state    {:initiative 1}
           :template "+{{ initiative }} for each contained soul with a non-unique era"}]
 :origin [{:template "For each contained soul of {{ x|random:soul-origin }} origin, gain proficiency in one skill of your choice"}
          {:template "For each contained soul of otherwordly origin, gain proficiency in one language of your choice. You can change your choice of languages on a long rest."}
          {:state    {:damage 1}
           :template "While at least one contained soul is of bestial origin, +{{ damage }} physical damage."}
          {:state    {:rounds 1}
           :template "When a contained soul of celestial origin procs, gain the benefits of the Bless spell for {{ rounds }} round(s)"}
          {:state    {:tokens 5}
           :template "While at least one contained soul is of draconic origin, selling items grants {{ tokens }} additional generic mythic tokens."}
          {:state    {:damage 1}
           :template "While at least one contained soul is of elemental origin, +{{ damage }} non-physical damage."}
          {:state    {:skills 1}
           :template "While at least one contained soul is of humanoid origin, +{{ skills }} with {{ x|random:ability-scores }} skills"}
          {:template "When a contained soul of fey origin procs, gain one free-action use of the Dash action that expires at the end of the combat"}
          {:state    {:ab 1}
           :template "While at least two contained souls are of fiendish origin, +{{ ab }} AB with spells"}
          {:state    {:ab 1}
           :template "While at least one contained souls is of monstrous origin, +{{ ab }} AB with maneuvers and with attacks triggered by maneuvers"}
          {:template "If all contained souls are of the same origin, they all proc whenever one of them procs."}]
 :other  [{:state    {:damage 3}
           :template "Damage and harm dealt by contained souls is increased by {{ damage }}"}
          {:state    {:recovery 1}
           :template "For each contained soul that didn't proc this round, recover {{ recovery }} hit points at the start of your turn"}
          {:state    {:rounds 1}
           :template "While not under any duration-based soul effects, effects granted by contained souls' procs last for {{ rounds }} additional round(s)"}
          {:template "If all contained souls embody the same trait, their passive and proc mods are all considered to be one rank higher"}
          {:template "The proc chance of the first soul in this reliquary is doubled, but the other contained souls cannot proc"}
          {:template "The proc chance of the last soul in this reliquary is doubled, but it grants no passive bonus"}
          {:template "The passive mods of contained souls are considered to be one higher, but you gain no bonuses from souls on rounds where at least one soul has procced"}
          {:template "When rolling for initiative for the first time on a given day, generate a random soul to be added to this reliquary until your next long rest"}]}
